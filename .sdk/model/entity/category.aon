    name: "id"
  }

  name: "category"
  op: {
    list: {
      name: "list"
      points: [
        {
          contract: {
            id: "GET /categories"
            json: "{\"operationId\":\"getCategories\",\"parameters\":[],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":[\"smileys and people\",\"animals and nature\",\"food and drink\",\"travel and places\",\"activities\",\"objects\",\"symbols\",\"flags\"],\"schema\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"}}},\"description\":\"Successful response\"}},\"securitySource\":\"unspecified\"}"
