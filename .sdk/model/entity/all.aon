# Entity: all

main: kit: entity: all: {

  alias: field: {}

  fields: [
    {
      name: "category"
      req: true
      short: "The category the emoji belongs to"
      type: "`$STRING`"
    }
    {
      name: "group"
      req: true
      short: "The group the emoji belongs to"
      type: "`$STRING`"
    }
    {
      name: "htmlCode"
      req: true
      short: "Array of HTML entity codes for the emoji"
      type: "`$ARRAY`"
    }
    {
      name: "name"
      req: true
      short: "The name of the emoji"
      type: "`$STRING`"
    }
    {
      name: "unicode"
      req: true
      short: "Array of Unicode code points for the emoji"
      type: "`$ARRAY`"
    }
  ]

  name: "all"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/all"
          parts: [
            "all"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
